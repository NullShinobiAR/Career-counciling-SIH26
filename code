        )

        col1, col2 = st.columns(2)

        with col1:
            st.write("**Recommended Course:**")
            st.write(result["Course"])

            st.write("**Possible Jobs:**")
            st.write(result["Jobs"])

        with col2:
            st.write("**Why this career?**")
            st.write(result["Reason"])

            st.write("**Matching Factors:**")
            st.write(result["Match Details"])

        st.divider()

    # -------------------------------------------------
    # SKILL GAP
    # -------------------------------------------------

    st.header("📊 Skill Gap Analysis")

    top_career = results[0]["Career"]

    skill_map = {
        "Electronics Technician":
            ["Basic Electronics", "Digital Electronics", "Circuit Testing"],

        "Embedded Systems Technician":
            ["C Programming", "Microcontrollers", "Arduino", "IoT"],

        "Industrial Automation Technician":
            ["PLC", "Sensors", "Industrial Control"],

        "Web Developer":
            ["HTML", "CSS", "JavaScript", "Programming"],

        "Electrical Technician":
            ["Electrical Wiring", "Circuit Testing", "Electrical Safety"],

        "Automobile Technician":
            ["Vehicle Maintenance", "Engine Basics", "Diagnostics"],

        "Healthcare Technician":
            ["Basic Healthcare", "Laboratory Skills", "Medical Safety"]
    }

    required_skills = skill_map.get(top_career, [])

    st.write(
        f"Skills required for **{top_career}**:"
    )

    for required in required_skills:
        if required.lower() in skill.lower():
            st.success(f"✅ {required}")
        else:
            st.warning(f"📚 Learn: {required}")

    # -------------------------------------------------
    # FAMILY DECISION SUPPORT
    # -------------------------------------------------

    st.header("👨‍👩‍👧 Family Decision Support")

    st.write(
        f"Your main family concern is **{parent_concern}**."
    )

    if parent_concern == "Job Opportunities":
        st.info(
            "The recommended pathway is connected to practical "
            "technical occupations and employment-oriented skills."
        )

    elif parent_concern == "Course Cost":
        st.info(
            "Consider government ITIs, skill-development centres "
            "and affordable vocational training programmes."
        )

    elif parent_concern == "Course Duration":
        st.info(
            "Vocational pathways can provide shorter, "
            "skill-focused training compared with many degree pathways."
        )

    elif parent_concern == "Career Stability":
        st.info(
            "Compare industry demand, required skills and "
            "long-term career progression before making a decision."
        )

    else:
        st.info(
            "Choose a pathway that provides opportunities for "
            "continuous skill development and career progression."
        )

    # -------------------------------------------------
    # FINAL EXPLANATION
    # -------------------------------------------------

    st.header("💡 AI Recommendation Explanation")

    st.write(
        f"Based on your **{interest} interest**, "
        f"**{education} education**, current skill in "
        f"**{skill}**, and **{budget} training budget**, "
        f"the system recommends **{top_career}** as your "
        f"top career pathway."
    )

    st.caption(
        "⚠️ This platform provides career guidance and decision "
        "support. It should not replace professional counselling "
        "or official admission and employment information."
    )
