]

# -------------------------------------------------
# SIDEBAR
# -------------------------------------------------

st.sidebar.header("👤 Student Profile")

name = st.sidebar.text_input("Student Name")

education = st.sidebar.selectbox(
    "Education Level",
    ["10th", "12th", "Diploma", "Degree"]
)

interest = st.sidebar.selectbox(
    "Main Interest",
    [
        "Electronics",
        "Technology",
        "Programming",
        "Electrical",
        "Machines",
        "Automobile",
        "Healthcare",
        "Science"
    ]
)

skill = st.sidebar.selectbox(
    "Current Skill",
    [
        "Electronics",
        "Programming",
        "Electrical",
        "Mechanical",
        "Machines",
        "Science"
    ]
)

budget = st.sidebar.selectbox(
    "Training Budget",
    ["Low", "Medium", "High"]
)

location = st.sidebar.text_input(
    "Preferred Location",
    "Tamil Nadu"
)

parent_concern = st.sidebar.selectbox(
    "Main Family Concern",
    [
        "Job Opportunities",
        "Course Cost",
        "Course Duration",
        "Career Stability",
        "Future Growth"
    ]
)

# -------------------------------------------------
# RECOMMENDATION FUNCTION
# -------------------------------------------------

def recommend_careers():

    results = []

    for career in careers:

        score = 0
        reasons = []

        # Interest matching
        if interest in career["interest"]:
            score += 40
            reasons.append("Matches your interest")

        # Education matching
        if education in career["education"]:
            score += 20
            reasons.append("Matches your education level")

        # Skill matching
        if skill in career["skills"]:
            score += 20
            reasons.append("Matches your existing skill")

        # Budget matching
        if budget in career["budget"]:
            score += 10
            reasons.append("Fits your training budget")

        # Location
        if location.strip():
            score += 10

        results.append({
            "Career": career["career"],
            "Score": score,
            "Course": career["course"],
            "Jobs": career["jobs"],
            "Reason": career["reason"],
            "Match Details": ", ".join(reasons)
        })

    results = sorted(
        results,
        key=lambda x: x["Score"],
        reverse=True
    )

    return results


# -------------------------------------------------
# MAIN BUTTON
# -------------------------------------------------

if st.button("🔍 Find My Career Path", use_container_width=True):

    if not name:
        name = "Student"

    results = recommend_careers()

    st.success(
        f"Hello {name}! Here are your personalized career pathways."
    )

    st.header("🎯 Recommended Career Pathways")

    # Show top 3 recommendations
    for i, result in enumerate(results[:3]):

        st.subheader(
